# Discord Bot Environment Variables
DISCORD_TOKEN=...
DISCORD_GUILD_ID=...
DISCORD_BOT_ID=...

# Database Environment Variables
DATABASE_URL=...
DATABASE_AUTH_TOKEN=...
SQL_ECHO=false

# API Configuration
API_ENABLED=true
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=/api

# Frontend | Backend Environment Variables (Urls)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Google Sheets API Environment Variables
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_CREDENTIALS=path/to/credentials.json
GOOGLE_SHEETS_SPREADSHEET_ID=...

# Activity Tracking Environment Variables
ACTIVITY_TRACKING_ENABLED=true
ACTIVITY_TRACKING_INTERVAL=60
ACTIVITY_TRACKING_CHANNELS=path/to/channels.json

# ML/AI Environment Variables
AI_REPORTS_ENABLED=true
GEMINI_API_KEY=...

ML_ENABLED=false
ML_MODEL_PATH=models
ML_PREDICTION_INTERVAL=86400

# Command Cooldown Environment Variables
COOLDOWN_ACTIVITY=5
COOLDOWN_REPORT=30
COOLDOWN_ADMIN=3

# Feature Flags (Optional) Environment Variables
FEATURE_VOICE_TRACKING=true
FEATURE_REACTION_TRACKING=true
FEATURE_PRESENCE_TRACKING=true
FEATURE_DASHBOARD_INTEGRATION=true
